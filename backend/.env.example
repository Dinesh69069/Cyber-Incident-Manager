# ─────────────────────────────────────────────────────────────────────────────
# Cyber Incident Management Platform - Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# --- SUPABASE (POSTGRESQL) CONFIGURATION ---
# Replace with your Supabase URI from: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# Note: For pooling mode (port 6543) or direct connection (port 5432), ensure ?sslmode=require is appended.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# --- JWT AUTHENTICATION SECRET ---
# Replace with a strong random string (e.g., generated with `openssl rand -hex 32`)
JWT_SECRET_KEY="cyber-incident-platform-super-secret-key-change-in-prod"

# --- STRIPE BILLING (TEST MODE) ---
# Replace with test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_51ExampleTestKeyReplaceWithRealTestKey"
STRIPE_WEBHOOK_SECRET="whsec_test_ReplaceWithRealWebhookSecret"

# --- UPI PAYMENTS ---
# Valid UPI Virtual Payment Address for QR Code payments
UPI_VPA="7008307149@nyes"
